config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option dhcp_default_duid 'auto'

# 容器内的 eth0 由 Docker 分配地址；proto none 表示 netifd 不去改它。
# 这样即使运行 /sbin/init，也不会生成 192.168.1.1/24 的 br-lan 把容器网络顶掉。
config interface 'lan'
	option device 'eth0'
	option proto 'none'
