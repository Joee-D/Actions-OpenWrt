# ------------------------------------------------------------
# ① 目标平台（Target）
# ------------------------------------------------------------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ------------------------------------------------------------
# ② 固件与分区（Image / Partition）
# ------------------------------------------------------------
# 内核分区 32MB / 根分区 2GB
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
# UEFI 启动（combined-efi.img），不需要 legacy BIOS 镜像
# CONFIG_GRUB_IMAGES is not set
# 不要 ext4 / tar.gz 根文件系统镜像
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set

# ------------------------------------------------------------
# ③ 内核（Kernel）
# ------------------------------------------------------------
# 省空间：不带内核调试信息
# CONFIG_KERNEL_DEBUG_INFO is not set
# BBR 拥塞控制（唯一显式保留的内核模块）
CONFIG_PACKAGE_kmod-tcp-bbr=y

# ------------------------------------------------------------
# ④ LuCI 应用与中文（后端与语言包全部自动勾选，无需写）
# ------------------------------------------------------------
# 中文开关：自动补全各 luci-app 的 zh-cn 语言包（升级后界面变英文则加回 luci-i18n-base-zh-cn）
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y

# ------------------------------------------------------------
# ⑤ 唯一必须显式保留（实测不自动补齐）
# ------------------------------------------------------------
# Cloudflare DDNS 提供者（对应 luci-app-ddns；其余后端全部自动勾选）
CONFIG_PACKAGE_ddns-scripts-cloudflare=y

# ------------------------------------------------------------
# ⑥ 系统与工具（无 luci-app 对应，按需保留）
# ------------------------------------------------------------
# USB/外置盘自动挂载（若不用可删这两行）
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y
# CPU 中断均衡（软路由多网卡有益）
CONFIG_PACKAGE_irqbalance=y
# 诊断工具
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y